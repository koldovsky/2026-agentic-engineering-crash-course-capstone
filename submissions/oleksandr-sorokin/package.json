{
  "name": "etf-scaffold",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "agents:sync": "node scripts/agents-sync.mjs",
    "agents:check": "node scripts/agents-sync.mjs --check",
    "hooks:selftest": "node scripts/hooks-selftest.mjs",
    "agent:log": "node scripts/agent-log-summary.mjs",
    "agent:loop": "node scripts/agent-loop.mjs",
    "agent:report": "node .agents/skills/agent-log-report/scripts/report.mjs",
    "verify": "node scripts/verify-report.mjs",
    "openspec": "node scripts/openspec.mjs",
    "spec:validate": "node scripts/openspec.mjs validate --all --strict --no-interactive",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm agents:check && pnpm spec:validate"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "recharts": "^3.10.1"
  },
  "devDependencies": {
    "@fission-ai/openspec": "^1.13.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@12.6.0"
}
