# MySQL
MYSQL_ROOT_PASSWORD=root_secret
MYSQL_USER=demo
MYSQL_PASSWORD=demo_secret

# Composer API key (GitHub token) used to avoid rate limits / access private repos
COMPOSER_GITHUB_TOKEN=

# Yii cookie validation keys, one per application (random, e.g. 32 hex characters); the apps refuse to run without them
DEMO_COOKIE_VALIDATION_KEY=
EMULATOR_COOKIE_VALIDATION_KEY=

# RabbitMQ (emulator's delayed callback, docs/architecture/flow.md §6a)
RABBITMQ_USER=emulator
RABBITMQ_PASSWORD=emulator_secret

# Module "test" signing key pair (demo/modules/test; docs/architecture/flow.md §1b) - generate with `openssl rand -hex 16`/`32`
TEST_API_KEY=
TEST_SECRET_KEY=

# Module "mail_service" signing key pair (demo/modules/mail_service; docs/architecture/flow.md §1b) - the static demo
# values are in development/mail_service/specs/module.service.yaml; copy them into .env
MAIL_SERVICE_API_KEY=
MAIL_SERVICE_SECRET_KEY=

# Xdebug
XDEBUG_MODE=debug
XDEBUG_CLIENT_HOST=host.docker.internal
XDEBUG_CLIENT_PORT=9003
